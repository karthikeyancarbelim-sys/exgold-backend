# Runtime environment template. Keep real values only in the deployment secret store.
NODE_ENV=production
FRONTEND_URL=https://app.exgold.in
PUBLIC_API_URL=https://api.exgold.in

# Set one Firebase credential source. Do not commit a service-account JSON file.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json

# Populate from the approved Augmont production credentials and documentation.
AUGMONT_API_ROOT=
AUGMONT_BASE_URL=
AUGMONT_LOGIN_BASE_URL=
AUGMONT_LOGIN_PATH=
AUGMONT_LOGIN_CONTENT_TYPE=form
AUGMONT_EMAIL=
AUGMONT_PASSWORD=
AUGMONT_MERCHANT_ID=
AUGMONT_MERCHANT_HEADER=X-Merchant-Id
AUGMONT_AUTH_HEADER=Authorization
AUGMONT_AUTH_SCHEME=Bearer
AUGMONT_TOKEN_TTL_SECONDS=86400
AUGMONT_LOGIN_REUSE_HOURS=24
AUGMONT_TOKEN_ENCRYPTION_KEY=
MIN_DIGITAL_GOLD_PURCHASE_AMOUNT=5
MAX_DIGITAL_GOLD_PURCHASE_AMOUNT=5000000
MAX_DIGITAL_GOLD_SELL_AMOUNT=1000000
DIGITAL_GOLD_KYC_THRESHOLD=180000
DIGITAL_GOLD_SELL_LOCK_HOURS=48
AUGMONT_MAX_BANK_IDS=3
AUGMONT_MAX_BANK_MODIFICATIONS=3
AUGMONT_GOLD_TAX_RATE=3

# Public payment identifiers may be supplied to the mobile app. Keep secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# KYCAID identity verification (only used when KYC_PROVIDER=kycaid).
KYC_PROVIDER=nerotix
KYCAID_API_TOKEN=
KYCAID_FORM_ID=
KYCAID_REDIRECT_URL=
# Required: shared secret the KYCAID webhook must send back (as a ?token= query
# param or an X-Kycaid-Secret header) before /kyc/kycaid/callback trusts its
# payload. The callback endpoint has no other auth and fails closed without this.
KYCAID_WEBHOOK_SECRET=

# Nerotix bank verification. The current provider collection documents only
# bank validation; automated DMT stays disabled until transfer, status,
# callback, and reconciliation contracts are supplied by Nerotix.
NEROTIX_API_TOKEN=
NEROTIX_AUTH_HEADER=Authorization
NEROTIX_AUTH_SCHEME=Bearer
NEROTIX_BANK_VERIFY_URL=https://api.nerofy.in/api/v1/service/bank/verification
NEROTIX_BANK_VERIFY_TIMEOUT_MS=15000
NEROTIX_DMT_ENABLED=false
# Production gold transactions require this explicit live declaration and
# non-UAT Augmont endpoints. Keep it as uat for local/provider testing.
AUGMONT_ENVIRONMENT=uat
# Live sell transactions must pay the user's verified bank directly.
AUGMONT_SELL_PAYOUT_MODE=direct_customer
AUGMONT_SALE_RECONCILE_INTERVAL_MS=120000
AUGMONT_BUY_RECONCILE_INTERVAL_MS=120000
