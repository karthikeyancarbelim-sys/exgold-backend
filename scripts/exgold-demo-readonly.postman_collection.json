  "item": [
    {
      "name": "Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "{{baseUrl}}/users/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Profile: expected HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Response is JSON\", function () { pm.response.json(); });"
            ]
          }
        }
      ]
    },
