{
  "info": {
    "name": "Augmont Remaining Checklist Read-Only Probes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Cases 8/17–24: provider buy history",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{idToken}}"
          }
        ],
        "url": "{{baseUrl}}/augmont/users/{{demoUid}}/buy"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.json());",
              "pm.test(\"No explicit provider failure\", () => { const body = pm.response.json(); pm.expect(body.success).not.to.eql(false); if (body.statusCode !== undefined) pm.expect(Number(body.statusCode)).to.eql(200); });"
            ]
          }
        }
      ]
    },
